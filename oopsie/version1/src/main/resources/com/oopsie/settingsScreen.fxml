
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="settingsPanel"
      alignment="CENTER"
      spacing="22"
      prefWidth="480"
      prefHeight="430"
      maxWidth="480"
      maxHeight="430"
      style="-fx-background-color: #FFF8E7;
             -fx-background-radius: 20;
             -fx-border-color: #9C7653;
             -fx-border-width: 4;
             -fx-border-radius: 20;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oopsie.sceneControllers.settingsScreenController">

    <padding>
        <Insets top="20" bottom="25" left="35" right="35"/>
    </padding>

    <!-- TITLE BAR -->
    <HBox fx:id="titleBar"
          alignment="CENTER"
          prefHeight="55"
          style="-fx-background-color: #E8D2AC;
                 -fx-background-radius: 12;">

        <Label text="GAME SETTINGS"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #65452D;"/>
    </HBox>

    <!-- MUSIC VOLUME -->
    <VBox spacing="10" alignment="CENTER_LEFT">

        <Label text="Music Volume"
               style="-fx-font-size: 17px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #65452D;"/>

        <Slider fx:id="musicSlider"
                min="0"
                max="100"
                value="70"
                prefWidth="380"/>

    </VBox>

    <!-- SOUND EFFECTS VOLUME -->
    <VBox spacing="10" alignment="CENTER_LEFT">

        <Label text="Sound Effects Volume"
               style="-fx-font-size: 17px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #65452D;"/>

        <Slider fx:id="soundSlider"
                min="0"
                max="100"
                value="70"
                prefWidth="380"/>

    </VBox>

    <!-- BUTTONS -->
    <VBox spacing="12" alignment="CENTER">

        <Button text="RETURN TO MAIN MENU"
                onAction="#quitToMenu"
                prefWidth="280"
                prefHeight="42"
                style="-fx-background-color: #A87850;
                       -fx-background-radius: 10;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Button text="CLOSE SETTINGS"
                onAction="#closeSettings"
                prefWidth="280"
                prefHeight="42"
                style="-fx-background-color: #D6B98C;
                       -fx-background-radius: 10;
                       -fx-text-fill: #65452D;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

    </VBox>

    <Label text="Press ESC to close settings"
           style="-fx-font-size: 12px;
                  -fx-text-fill: #92785F;"/>

</VBox>
