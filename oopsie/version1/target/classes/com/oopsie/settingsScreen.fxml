
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="settingsPanel"
      alignment="CENTER"
      spacing="20"
      prefWidth="480"
      prefHeight="430"
      style="-fx-background-color: #FFF8E7;
             -fx-background-radius: 20;
             -fx-border-color: #9C7653;
             -fx-border-width: 4;
             -fx-border-radius: 20;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.oopsie.sceneControllers.settingsScreenController">

    <padding>
        <Insets top="20" bottom="25" left="35" right="35"/>
    </padding>

    <HBox fx:id="titleBar" alignment="CENTER">
        <Label text="GAME SETTINGS"
               style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="10">
        <Label text="Music Volume"/>
        <Slider fx:id="musicSlider" min="0" max="100" value="70"/>
    </VBox>

    <VBox spacing="10">
        <Label text="Sound Effects Volume"/>
        <Slider fx:id="soundSlider" min="0" max="100" value="70"/>
    </VBox>

    <Button text="RETURN TO MAIN MENU"
            onAction="#quitToMenu"/>

    <Button text="CLOSE SETTINGS"
            onAction="#closeSettings"/>

    <Label text="Press ESC to close settings"/>

</VBox>
