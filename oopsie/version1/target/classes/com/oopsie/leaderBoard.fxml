<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" stylesheets="@styles/leaderboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.oopsie.sceneControllers.leaderboardController">

    <children>

        <!-- BACKGROUND -->
        <ImageView fitHeight="738.0" fitWidth="1296.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="-7.37518310546875" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="-16.0" AnchorPane.topAnchor="0.0">

            <image>
                <Image url="@images/LeaderboardScreen.png" />
            </image>
        </ImageView>


        <TableView fx:id="leaderboardTable" layoutX="67.2" layoutY="179.2" prefHeight="471.0" prefWidth="1148.0" styleClass="leaderboard-table" AnchorPane.leftAnchor="67.0" AnchorPane.topAnchor="179.0">

            <placeholder>
                <Label styleClass="empty-label" text="No scores recorded yet!">
                    <font>
                        <Font name="Cascadia Mono" size="16.0" />
                    </font>
                </Label>
            </placeholder>

            <columns>

                <TableColumn fx:id="nameColumn" prefWidth="637.5999622344971" sortable="false" styleClass="player-column" text="PLAYER" />

                <TableColumn fx:id="scoreColumn" prefWidth="579.199951171875" sortable="false" styleClass="score-column" text="SCORE" />

            </columns>

        </TableView>


        <!-- EXIT BUTTON -->
        <Button fx:id="quitButton" layoutX="54.0" layoutY="639.0" mnemonicParsing="false" onAction="#switchToTitle" prefHeight="65.0" prefWidth="245.0" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="-6.2000000000000455" AnchorPane.leftAnchor="54.0">
         <graphic>
                <ImageView fitHeight="103.0" fitWidth="237.0" pickOnBounds="true" preserveRatio="true">
      
                          <image>
                        <Image url="@images/buttons/ExitButton.png" />
                    </image>
      
                      </ImageView>
         </graphic></Button>

    </children>
</AnchorPane>
